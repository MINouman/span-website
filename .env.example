# Copy to .env and fill in. Never commit .env.

# PostgreSQL. Local example uses the Unix socket with peer auth.
DATABASE_URL=postgresql:///span?host=/var/run/postgresql

# Long random string: openssl rand -hex 32
PAYLOAD_SECRET=

# Public site URL, used for canonical URLs, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Step 2: Cloudflare R2 media storage
# R2_BUCKET=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://cdn.example.com

# Step 4: form notifications and spam protection
# RESEND_API_KEY=
# NOTIFY_EMAIL_TO=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
